{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs", // ESNext 대신 commonjs로 설정
    "outDir": "lib", // 컴파일된 JavaScript 파일이 저장될 폴더
    "rootDir": "src", // TypeScript 소스 파일의 루트 디렉토리
    "strict": true,
    "esModuleInterop": true, // CommonJS와 ES 모듈 간의 호환성을 위한 설정
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
